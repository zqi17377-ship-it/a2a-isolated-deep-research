# Optional OpenAI-Compatible API Configuration
# Leave OPENAI_API_KEY unset to run in deterministic Stateful Research Simulator mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# A2A Router & Execution Settings
A2A_SIMULATED_IO_LATENCY_MS=35
A2A_MAX_RE_RETRIEVAL_ROUNDS=1
